# Tài khoản vào trang /admin. Copy file này thành .env rồi sửa lại.
# Không đặt tiền tố VITE_ để mật khẩu không bị nhúng vào code gửi cho khách.
# Deploy lên Vercel thì khai báo 2 biến này trong phần Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-cho-dai-va-kho-doan

# Link Google Form xác nhận tham dự (dạng https://docs.google.com/forms/d/e/.../viewform).
# Có tiền tố VITE_ vì thiệp cần dùng link này (link form không phải bí mật). Để trống thì form ẩn khỏi thiệp.
VITE_RSVP_FORM_URL=
