{
  "name": "wedding-invitation-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:nha-gai": "npm run dev -w apps/nha-gai",
    "dev:nha-trai": "npm run dev -w apps/nha-trai",
    "build:nha-gai": "npm run build -w apps/nha-gai",
    "build:nha-trai": "npm run build -w apps/nha-trai",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
